<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="insight_deal_prefs_encrypted.xml" />
        <exclude domain="sharedpref" path="insight_deal_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="insight_deal_prefs.xml" />
        <exclude domain="sharedpref" path="insightdeal_prefs.xml" />
        <exclude domain="sharedpref" path="device.xml" />
        <exclude domain="sharedpref" path="sensitive_data.xml" />
        <include domain="file" path="." />
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="insight_deal_prefs_encrypted.xml" />
        <exclude domain="sharedpref" path="insight_deal_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="insight_deal_prefs.xml" />
        <exclude domain="sharedpref" path="insightdeal_prefs.xml" />
        <exclude domain="sharedpref" path="device.xml" />
        <exclude domain="sharedpref" path="sensitive_data.xml" />
        <include domain="file" path="." />
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
