# Database (PostgreSQL/MySQL Url)
DATABASE_URL=postgresql://user:password@localhost:5432/insightdeal

# Naver Shopping API
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# OpenAPI / AI Extractor (0원 무료 티어 마이크로배치 3줄 요약)
USE_GEMINI_AI=false
# 결제 계정이 연결되지 않은 Google AI Studio Free Tier 키 사용 권장 (과금 0원 고정)
GEMINI_API_KEY=your_free_tier_gemini_api_key_here
GEMINI_SUMMARY_MODEL=gemini-2.5-flash-lite

# 선택 무료 백업 프로바이더 (Groq Free Tier 또는 로컬 LM Studio http://localhost:1234/v1)
# GROQ_API_KEY=
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model

# 선택 무료 백업 프로바이더 (Cloudflare Workers AI)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_API_TOKEN=

# 일일 AI 호출 상한 및 신규 딜 디바운스 묶음 대기 시간(초)
AI_MAX_DAILY_CALLS=200
AI_MICROBATCH_DEBOUNCE_SEC=8

# Security
ALLOWED_ORIGINS=http://localhost,http://10.0.2.2,https://insightdeal.app

# Scheduler
SCRAPE_INTERVAL_MINUTES=30
